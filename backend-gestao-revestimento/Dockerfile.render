# syntax=docker/dockerfile:1.7
# Único serviço Render: somente Spring. O login ocorre no Chrome do usuário
# com a extensão RedeASSO, sem Chromium, Selenium, VNC ou gateway no servidor.
# O frontend permanece no Cloudflare; este contexto de build é a raiz do repo.
FROM eclipse-temurin:21-jdk-jammy AS build

WORKDIR /workspace

COPY backend-gestao-revestimento/.mvn .mvn
COPY backend-gestao-revestimento/mvnw backend-gestao-revestimento/pom.xml ./
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw
RUN --mount=type=cache,id=redeasso-render-maven,target=/root/.m2 \
    ./mvnw -B -ntp dependency:go-offline

COPY backend-gestao-revestimento/src src
RUN --mount=type=cache,id=redeasso-render-maven,target=/root/.m2 \
    ./mvnw -B -ntp package

FROM eclipse-temurin:21-jre-jammy
RUN groupadd --system redeasso && useradd --system --create-home --gid redeasso redeasso
ENV JAVA_TOOL_OPTIONS="-Xms32m -XX:MaxRAMPercentage=60.0 -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError"
WORKDIR /app

COPY --from=build --chown=redeasso:redeasso /workspace/target/*.jar /app/redeasso.jar
USER redeasso
EXPOSE 10000

ENTRYPOINT ["java", "-jar", "/app/redeasso.jar"]
