# PostgreSQL local de desenvolvimento. Não use estas credenciais em produção.
POSTGRES_DB=redeasso
POSTGRES_USER=redeasso
POSTGRES_PASSWORD=redeasso
POSTGRES_PORT=5432

# Spring local
DATABASE_URL=jdbc:postgresql://localhost:5432/redeasso
DATABASE_USERNAME=redeasso
DATABASE_PASSWORD=redeasso
REDEASSO_LOCAL_ADMIN_ENABLED=true
REDEASSO_LOCAL_ADMIN_USERNAME=admin
REDEASSO_LOCAL_ADMIN_PASSWORD=admin
