# Copie para .env. Nunca versione o arquivo .env real.
POSTGRES_DB=redeasso
POSTGRES_USER=redeasso
POSTGRES_PASSWORD=troque-por-uma-senha-forte

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Use true no servidor acessado por HTTPS via Tailscale Serve. O fallback local
# direto usa HTTP e, portanto, precisa de false para aceitar a sessão.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=12h

# Acesso temporário para os testes enquanto o login Área Central não foi
# implementado. Troque a senha ou desative antes de expor o serviço.
REDEASSO_LOCAL_ADMIN_ENABLED=true
REDEASSO_LOCAL_ADMIN_USERNAME=admin
REDEASSO_LOCAL_ADMIN_PASSWORD=admin

# Opcional no servidor: imagem publicada pelo workflow do GitHub.
# REDEASSO_IMAGE=ghcr.io/douglasbohmer/sistema-gestao-revestimentos:main

# Neon/Render: a aplicação em nuvem usa o PostgreSQL Neon diretamente. No
# Render, informe os três valores como segredos de ambiente; não use a URL
# postgresql:// inteira como DATABASE_URL. O Spring espera uma URL JDBC.
# DATABASE_URL=jdbc:postgresql://ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=senha-do-neon
# DATABASE_MAX_POOL_SIZE=5
# SESSION_COOKIE_SAME_SITE=lax

# Área Central/noVNC. Obrigatório ao usar
# docker-compose.area-central.yml (desenvolvimento) ou
# docker-compose.area-central-browser.server.yml (servidor da loja). O gateway
# é a única porta publicada; ele valida a chave interna do Spring e o token
# curto do modal antes do noVNC. Usuário, senha e CAPTCHA são digitados no
# Chrome gráfico exibido pelo modal, nunca enviados ao backend.
# Gere os dois valores com pelo menos 32 caracteres aleatórios e nunca os use
# em VITE_*, commits, logs ou em uma URL manual.
# AREA_CENTRAL_BROWSER_SERVICE_KEY=troque-por-uma-chave-interna-aleatoria
# AREA_CENTRAL_INTERACTIVE_TOKEN_SECRET=troque-por-um-segredo-hmac-aleatorio
# AREA_CENTRAL_BROWSER_BIND_ADDRESS=127.0.0.1
# AREA_CENTRAL_BROWSER_PORT=7900
# Opcional no servidor: imagem publicada pelo GitHub Actions e atualizada pelo
# Watchtower. So altere para validar manualmente uma imagem especifica.
# REDEASSO_BROWSER_IMAGE=ghcr.io/douglasbohmer/sistema-gestao-revestimentos:area-central-browser-main
# Se usar Vite local, troque para http://localhost:5000. No servidor da loja,
# use a origem HTTPS exata do Worker Cloudflare, sem barra final.
# AREA_CENTRAL_ALLOWED_FRAME_ORIGIN=http://localhost:8080
# AREA_CENTRAL_INTERACTIVE_URL=http://localhost:7900/vnc.html
