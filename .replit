modules = ["nodejs-24"]

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8123
externalPort = 3002

[[ports]]
localPort = 23022
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend-gestao-revestimento && SERVER_PORT=3001 ./node_modules/.bin/tsx server/index.ts"
waitForPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd frontend-gestao-revestimento && NODE_ENV=production ./node_modules/.bin/tsx server/index.ts"]
build = ["bash", "-c", "cd frontend-gestao-revestimento && PORT=5000 BASE_PATH=/ pnpm run build"]
